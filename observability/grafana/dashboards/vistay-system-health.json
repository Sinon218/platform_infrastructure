  "panels": [
    {
      "type": "row", "title": "TỔNG QUAN HỆ THỐNG", "id": 1,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": []
    },
    {
      "type": "stat", "title": "Services UP", "id": 2, "datasource": { "uid": "vistay-prometheus" },
      "description": "Số service đang được Prometheus scrape thành công.",
      "targets": [{ "expr": "sum(up{job=\"backoffice-services\",instance=~\"$service\"})", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 3 }, { "color": "green", "value": 5 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 }
    },
    {
      "type": "stat", "title": "Availability", "id": 3, "datasource": { "uid": "vistay-prometheus" },
      "targets": [{ "expr": "100 * avg(up{job=\"backoffice-services\",instance=~\"$service\"})", "instant": true, "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 99 }, { "color": "green", "value": 100 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 }
    },
    {
      "type": "stat", "title": "Request rate", "id": 4, "datasource": { "uid": "vistay-prometheus" },
      "description": "Lưu lượng nghiệp vụ; loại trừ actuator health/metrics.",
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"backoffice-services\",instance=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])) or vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 }
    },
    {
      "type": "stat", "title": "5xx error rate", "id": 5, "datasource": { "uid": "vistay-prometheus" },
      "targets": [{ "expr": "(100 * sum(rate(http_server_requests_seconds_count{job=\"backoffice-services\",instance=~\"$service\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"backoffice-services\",instance=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])), 0.001)) or vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 }
    },
    {
      "type": "stat", "title": "P95 latency", "id": 6, "datasource": { "uid": "vistay-prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"backoffice-services\",instance=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))) or vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1.5 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 }
    },
    {
      "type": "stat", "title": "Max heap pressure", "id": 7, "datasource": { "uid": "vistay-prometheus" },
      "targets": [{ "expr": "max(100 * sum by (instance) (jvm_memory_used_bytes{job=\"backoffice-services\",instance=~\"$service\",area=\"heap\"}) / clamp_min(sum by (instance) (jvm_memory_max_bytes{job=\"backoffice-services\",instance=~\"$service\",area=\"heap\"}), 1))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1, "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 }
    },

    {
      "type": "row", "title": "HTTP / API PERFORMANCE", "id": 8,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false, "panels": []
    },
    {
      "type": "timeseries", "title": "Requests / second by service", "id": 9, "datasource": { "uid": "vistay-prometheus" },
      "targets": [{ "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"backoffice-services\",instance=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "{{instance}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 18, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries", "title": "Errors / second by service", "id": 10, "datasource": { "uid": "vistay-prometheus" },
      "targets": [
        { "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"backoffice-services\",instance=~\"$service\",status=~\"4..\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "4xx · {{instance}}", "refId": "A" },
        { "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"backoffice-services\",instance=~\"$service\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "5xx · {{instance}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "/5xx/" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    },
    {
      "type": "timeseries", "title": "Latency percentiles", "id": 11, "datasource": { "uid": "vistay-prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"backoffice-services\",instance=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"backoffice-services\",instance=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"backoffice-services\",instance=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))", "legendFormat": "P99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "custom": { "drawStyle": "line", "fillOpacity": 12, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries", "title": "Traffic by HTTP status", "id": 12, "datasource": { "uid": "vistay-prometheus" },
      "targets": [{ "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"backoffice-services\",instance=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval]))", "legendFormat": "HTTP {{status}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 75, "lineWidth": 0, "showPoints": "never", "stacking": { "group": "A", "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 }
    },
    {
      "type": "bargauge", "title": "Top endpoints by request rate", "id": 13, "datasource": { "uid": "vistay-prometheus" },
      "targets": [{ "expr": "topk(12, sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"backoffice-services\",instance=~\"$service\",uri!~\"/actuator.*\"}[$__rate_interval])))", "instant": true, "legendFormat": "{{method}} · {{uri}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 3, "thresholds": { "mode": "percentage", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "orange", "value": 85 }] } }, "overrides": [] },
